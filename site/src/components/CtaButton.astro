---
interface Props {
  href: string;
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full font-medium transition duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky";

const variants = {
  primary: "bg-coral text-white hover:bg-coral-dark shadow-sm",
  outline: "border-2 border-navy-900/20 text-navy-900 hover:border-coral hover:text-coral bg-transparent",
  ghost: "text-white/90 hover:text-white border border-white/25 hover:border-white/50 bg-white/5 backdrop-blur-sm",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
  <slot />
</a>
