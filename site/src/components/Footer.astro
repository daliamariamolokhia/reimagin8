---
import { navLinks, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-surface bg-navy-950 px-4 py-12 text-white/70 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <p class="font-display text-2xl font-bold text-white">
          reimagin<span class="text-coral">8</span>
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed">{site.description}</p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-sky">Navigate</p>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm transition hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-sky">Contact</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="transition hover:text-white">{site.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-8 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} reimagin8. All rights reserved.</p>
      <p class="text-white/50">Strategy · Innovation · Leadership</p>
    </div>
  </div>
</footer>
