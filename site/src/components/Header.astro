---
import { navLinks, site } from "../data/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-surface bg-off-white/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="group flex items-center gap-3">
      <img src="/favicon.svg" alt="" class="h-10 w-10" width="40" height="40" />
      <div>
        <span class="block font-display text-xl font-bold leading-tight tracking-tight text-navy-900">
          reimagin<span class="text-coral">8</span>
        </span>
        <span class="hidden text-xs text-slate sm:block">{site.tagline}</span>
      </div>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm transition",
              currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                ? "font-semibold text-navy-900"
                : "text-slate hover:text-navy-900",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden rounded-full bg-navy-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-navy-950 sm:inline-block"
      >
        Start a conversation
      </a>

      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-surface bg-white px-4 py-2 text-sm font-medium text-navy-900">
          Menu
        </summary>
        <nav class="absolute right-0 mt-2 w-52 rounded-2xl border border-surface bg-white p-3 shadow-xl">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2 text-sm text-navy-900 hover:bg-surface"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="/contact"
            class="mt-2 block rounded-lg bg-navy-900 px-3 py-2 text-center text-sm font-medium text-white"
          >
            Start a conversation
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
