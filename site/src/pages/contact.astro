---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  calendlyUrl,
  contactInterestOptions,
  contactInterestValues,
  getCalendlyEmbedUrl,
  site,
} from "../data/site";

const calendlyEmbed = getCalendlyEmbedUrl();

const interestParam =
  Astro.url.searchParams.get("interest") ?? Astro.url.searchParams.get("experience") ?? "";
const selectedInterest = contactInterestValues.has(interestParam) ? interestParam : "discovery";

const interestGroups = contactInterestOptions.reduce<
  Record<string, typeof contactInterestOptions[number][]>
>((acc, option) => {
  (acc[option.group] ??= []).push(option);
  return acc;
}, {});
---

<Layout
  title="Contact"
  description="Start a conversation with reimagin8. Book a discovery call to explore how we can help your organisation reinvent and grow."
>
  <Header slot="header" />

  <section class="hero-gradient px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">Contact</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Start a conversation</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/75">
        We work with a select number of clients each quarter. Book a discovery call or send an enquiry. We'll be in
        touch within two business days.
      </p>
    </div>
  </section>

  <!-- Calendly -->
  {
    calendlyEmbed ? (
      <section id="book-a-call" class="scroll-mt-24 border-b border-surface bg-white px-4 py-16 sm:px-6">
        <div class="mx-auto max-w-4xl">
          <div class="mb-8 text-center">
            <h2 class="font-display text-2xl font-bold">Book a discovery call</h2>
            <p class="mt-2 text-slate">Pick a time that works: 30 minutes, no pitch, just clarity.</p>
            <p class="mt-3 text-sm text-slate">
              Prefer a direct link?{" "}
              <a href={calendlyUrl} class="font-medium text-coral hover:underline" target="_blank" rel="noopener noreferrer">
                Open Calendly in a new tab
              </a>
            </p>
          </div>
          <div
            class="calendly-inline-widget min-h-[700px] w-full overflow-hidden rounded-2xl border border-surface"
            data-url={calendlyEmbed}
            style="min-width:320px;height:700px;"
          />
        </div>
      </section>
    ) : (
      <section id="book-a-call" class="scroll-mt-24 border-b border-surface bg-surface/50 px-4 py-8 sm:px-6">
        <div class="mx-auto max-w-4xl rounded-xl border border-surface bg-white px-6 py-4 text-center text-sm text-slate">
          Online booking opens once{" "}
          <code class="text-navy-900">PUBLIC_CALENDLY_URL</code> is set in Netlify (your Calendly event link). Use the
          form below or email{" "}
          <a href={`mailto:${site.email}`} class="font-medium text-coral hover:underline">{site.email}</a>.
        </div>
      </section>
    )
  }

  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl font-bold">Send an enquiry</h2>
        <p class="mt-4 text-slate">
          Prefer email? Reach us directly at{" "}
          <a href={`mailto:${site.email}`} class="font-medium text-coral hover:underline">{site.email}</a>
        </p>

        <div class="mt-10 space-y-6">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-widest text-coral">What to expect</h3>
            <ul class="mt-3 space-y-2 text-sm text-slate">
              <li class="flex gap-2">
                <span class="text-coral">1.</span> Brief introductory call (30 mins)
              </li>
              <li class="flex gap-2">
                <span class="text-coral">2.</span> Honest assessment of fit
              </li>
              <li class="flex gap-2">
                <span class="text-coral">3.</span> Tailored proposal if we're aligned
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-widest text-coral">Ideal for</h3>
            <p class="mt-3 text-sm text-slate">
              CEOs, C-suite leaders, and founders of growth-stage organisations facing strategic inflection points:
              growth ceilings, market shifts, or leadership transitions.
            </p>
          </div>
        </div>
      </div>

      <form
        id="contact-form"
        name="contact"
        method="POST"
        class="rounded-2xl border border-surface bg-white p-8 shadow-sm lg:col-span-3"
      >
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" id="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div id="contact-form-status" class="mb-6 hidden rounded-xl px-4 py-3 text-sm" role="status"></div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium text-navy-900">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="mt-2 w-full rounded-xl border border-surface bg-off-white px-4 py-3 text-sm transition focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/20"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-navy-900">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="mt-2 w-full rounded-xl border border-surface bg-off-white px-4 py-3 text-sm transition focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/20"
            />
          </div>
        </div>

        <div class="mt-6">
          <label for="company" class="block text-sm font-medium text-navy-900">Company</label>
          <input
            type="text"
            id="company"
            name="company"
            class="mt-2 w-full rounded-xl border border-surface bg-off-white px-4 py-3 text-sm transition focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/20"
          />
        </div>

        <div class="mt-6">
          <label for="interest" class="block text-sm font-medium text-navy-900">I'm interested in</label>
          <select
            id="interest"
            name="interest"
            class="mt-2 w-full rounded-xl border border-surface bg-off-white px-4 py-3 text-sm transition focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/20"
          >
            {
              Object.entries(interestGroups).map(([group, options]) => (
                <optgroup label={group}>
                  {
                    options.map((option) => (
                      <option value={option.value} selected={option.value === selectedInterest}>
                        {option.label}
                      </option>
                    ))
                  }
                </optgroup>
              ))
            }
          </select>
        </div>

        <div class="mt-6">
          <label for="message" class="block text-sm font-medium text-navy-900">Tell us about your challenge</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-xl border border-surface bg-off-white px-4 py-3 text-sm transition focus:border-sky focus:outline-none focus:ring-2 focus:ring-sky/20"
            placeholder="What's stuck, and what would movement look like?"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="mt-8 w-full rounded-full bg-coral px-6 py-4 text-sm font-semibold text-white transition hover:bg-coral-dark disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
        >
          Send enquiry
        </button>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

{
  calendlyEmbed && (
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async />
  )
}

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("contact-form-status");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  function showStatus(kind: "success" | "error", message: string) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "bg-sky/10", "text-navy-800", "bg-coral/10", "text-navy-900");
    if (kind === "success") {
      statusEl.classList.add("bg-sky/10", "text-navy-800");
    } else {
      statusEl.classList.add("bg-coral/10", "text-navy-900");
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submitBtn) return;

    const fd = new FormData(form);
    const interestSelect = form.querySelector("#interest") as HTMLSelectElement | null;
    const interestLabel =
      interestSelect?.selectedOptions[0]?.textContent?.trim() ?? String(fd.get("interest") ?? "");

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";

    try {
      const res = await fetch("/.netlify/functions/contact-submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: fd.get("name"),
          email: fd.get("email"),
          company: fd.get("company"),
          interest: fd.get("interest"),
          interestLabel,
          message: fd.get("message"),
          botField: fd.get("bot-field"),
        }),
      });

      const data = (await res.json()) as { error?: string; ok?: boolean };

      if (!res.ok) {
        showStatus("error", data.error ?? "Something went wrong. Please email hello@reimagin8.com.");
        return;
      }

      showStatus(
        "success",
        "Thank you. Your enquiry has been sent. Check your inbox for a confirmation. We'll be in touch within two business days.",
      );
      form.reset();
    } catch {
      showStatus("error", "Network error. Please try again or email hello@reimagin8.com.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send enquiry";
    }
  });
</script>

