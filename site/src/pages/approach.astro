---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaButton from "../components/CtaButton.astro";
import PillarBadge from "../components/PillarBadge.astro";
import { approachSteps, threePillars } from "../data/site";
---

<Layout
  title="Approach"
  description="Our proven four-phase methodology: Diagnose, Design, Deliver, Develop. From insight to lasting organisational capability."
>
  <Header slot="header" />

  <section class="hero-gradient px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">Reimagine · Reinvent · Realise</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">How we work</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/75">
        Our four phases map to three pillars: insight, reinvention, and execution. Embedded in your organisation, not
        from the sidelines.
      </p>
    </div>
  </section>

  <section class="border-b border-surface bg-surface/40 px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
      {
        threePillars.map((pillar) => (
          <div class="rounded-xl border border-surface bg-white p-6">
            <PillarBadge pillar={pillar.id} />
            <p class="mt-3 text-sm leading-relaxed text-slate">{pillar.headline}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-2">
        {
          approachSteps.map((step, i) => (
            <article class="relative overflow-hidden rounded-2xl border border-surface bg-white p-8 shadow-sm">
              <div class="absolute -right-4 -top-4 font-display text-[8rem] font-bold leading-none text-coral/5">
                {step.step}
              </div>
              <div class="relative">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-block rounded-full bg-coral/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-coral">
                    Phase {step.step}
                  </span>
                  <PillarBadge pillar={step.pillar} />
                </div>
                <h2 class="mt-4 font-display text-2xl font-bold">{step.title}</h2>
                <p class="mt-3 leading-relaxed text-slate">{step.description}</p>
              </div>
              {i < approachSteps.length - 1 && (
                <div class="mt-6 hidden lg:block">
                  <div class="h-px w-full bg-gradient-to-r from-coral/30 to-transparent"></div>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-navy-900 px-4 py-16 text-white sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-3xl font-bold text-white">What sets us apart</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        <div>
          <h3 class="font-display text-lg font-semibold text-coral">Embedded, not advisory-only</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            We work alongside your team: in the room, in the workshop, in the implementation. Not from a distance.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-sky">Action over analysis paralysis</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Every engagement produces tangible outputs: prototypes, roadmaps, capability. Not just recommendations.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-coral">Selective by design</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            We take on a limited number of clients to ensure depth of impact. Quality over volume, always.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold">Let's diagnose your growth gap</h2>
      <p class="mt-4 text-lg text-slate">
        The first conversation is always exploratory. No pitch, no pressure. Just clarity on whether we're the right fit.
      </p>
      <div class="mt-8">
        <CtaButton href="/contact" size="lg">Book a discovery call</CtaButton>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
