---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaButton from "../components/CtaButton.astro";
import PillarBadge from "../components/PillarBadge.astro";
import { offeringsByPillar, services, threePillars } from "../data/site";

const reimagineServices = services.filter((s) => s.pillar === "reimagine");
const reinventPersonal = services.filter((s) => s.pillar === "reinvent" && s.reinventTrack === "personal");
const reinventBusiness = services.filter((s) => s.pillar === "reinvent" && s.reinventTrack === "business");
const realiseServices = services.filter((s) => s.pillar === "realise");

const reimaginePillar = threePillars.find((p) => p.id === "reimagine")!;
const reinventPillar = threePillars.find((p) => p.id === "reinvent")!;
const realisePillar = threePillars.find((p) => p.id === "realise")!;
---

<Layout
  title="Services"
  description="Reimagine, Reinvent, Realise. Advisory and build services mapped to where you are in your transformation journey."
>
  <Header slot="header" />

  <section class="hero-gradient px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">Reimagine · Reinvent · Realise</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">Three pillars. One partner.</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/75">
        Engage at the stage you're at: insight, reinvention, or execution. Alone or as a full journey from diagnosis
        to deployed solution.
      </p>
    </div>
  </section>

  <!-- Reimagine -->
  <section id="reimagine" class="scroll-mt-24 border-b border-surface px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <PillarBadge pillar="reimagine" />
      <h2 class="mt-4 font-display text-3xl font-bold">{reimaginePillar.name}</h2>
      <p class="mt-2 text-lg font-medium text-coral">{reimaginePillar.headline}</p>
      <p class="mt-4 max-w-3xl text-slate">{reimaginePillar.description}</p>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          reimagineServices.map((service) => (
            <article class="rounded-2xl border border-surface bg-white p-8 shadow-sm">
              <h3 class="font-display text-xl font-bold">{service.title}</h3>
              <p class="mt-3 leading-relaxed text-slate">{service.description}</p>
              <div class="mt-6">
                <CtaButton href={`/contact?interest=${service.slug}`} variant="outline">Discuss this service</CtaButton>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-8 rounded-xl border border-sky/20 bg-sky/5 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-sky">Also in Reimagine</p>
        <p class="mt-2 text-sm text-slate">
          Experiences:{" "}
          {offeringsByPillar.reimagine
            .filter((o) => o.kind === "Experience")
            .map((o) => o.name)
            .join(" · ")}.{" "}
          <a href="/workshops" class="font-semibold text-coral hover:underline">View experiences</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Reinvent -->
  <section id="reinvent" class="scroll-mt-24 border-b border-surface bg-surface/40 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <PillarBadge pillar="reinvent" />
      <h2 class="mt-4 font-display text-3xl font-bold">{reinventPillar.name}</h2>
      <p class="mt-2 text-lg font-medium text-coral">{reinventPillar.headline}</p>
      <p class="mt-4 max-w-3xl text-slate">{reinventPillar.description}</p>

      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        <div>
          <PillarBadge pillar="reinvent" track="personal" class="mb-4" />
          <div class="space-y-6">
            {
              reinventPersonal.map((service) => (
                <article class="rounded-2xl border border-surface bg-white p-8 shadow-sm">
                  <h3 class="font-display text-xl font-bold">{service.title}</h3>
                  <p class="mt-3 leading-relaxed text-slate">{service.description}</p>
                  <div class="mt-6">
                    <CtaButton href={`/contact?interest=${service.slug}`} variant="outline">Discuss this service</CtaButton>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
        <div>
          <PillarBadge pillar="reinvent" track="business" class="mb-4" />
          <div class="space-y-6">
            {
              reinventBusiness.map((service) => (
                <article class="rounded-2xl border border-surface bg-white p-8 shadow-sm">
                  <h3 class="font-display text-xl font-bold">{service.title}</h3>
                  <p class="mt-3 leading-relaxed text-slate">{service.description}</p>
                  <div class="mt-6">
                    <CtaButton href={`/contact?interest=${service.slug}`} variant="outline">Discuss this service</CtaButton>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-8 rounded-xl border border-coral/20 bg-coral/5 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-coral">Also in Reinvent</p>
        <p class="mt-2 text-sm text-slate">
          Experiences: The Reinvention Sprint · The Forcing Function · The Studio Intensive.{" "}
          <a href="/workshops" class="font-semibold text-coral hover:underline">View experiences</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Realise -->
  <section id="realise" class="scroll-mt-24 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <PillarBadge pillar="realise" />
      <h2 class="mt-4 font-display text-3xl font-bold">{realisePillar.name}</h2>
      <p class="mt-2 text-lg font-medium text-coral">{realisePillar.headline}</p>
      <p class="mt-4 max-w-3xl text-slate">{realisePillar.description}</p>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {
          realiseServices.map((service) => (
            <article class="rounded-2xl border border-coral/20 bg-white p-8 shadow-sm ring-1 ring-coral/10">
              <h3 class="font-display text-xl font-bold">{service.title}</h3>
              <p class="mt-3 leading-relaxed text-slate">{service.description}</p>
              <div class="mt-6 flex flex-wrap gap-4">
                <CtaButton href="/build">Learn more</CtaButton>
                <CtaButton href="/contact?interest=product-build" variant="outline">Discuss a build</CtaButton>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-8 rounded-xl border border-navy-900/10 bg-navy-900/5 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-navy-800">Also in Realise</p>
        <p class="mt-2 text-sm text-slate">
          MVP Build · Sprint to Ship · Proof of Concept · Product Partner · The Activation Room.{" "}
          <a href="/build" class="font-semibold text-coral hover:underline">View build formats</a>
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-surface bg-white px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold">Not sure which pillar?</h2>
      <p class="mt-4 text-lg text-slate">
        Most engagements begin with a discovery conversation. We'll help you identify whether you need to reimagine,
        reinvent, or realise. Or all three.
      </p>
      <div class="mt-8">
        <CtaButton href="/contact" size="lg">Book a discovery call</CtaButton>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
