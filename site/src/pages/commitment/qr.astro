---
import Layout from "../../layouts/Layout.astro";
import { defaultWorkshopSession, site } from "../../data/site";

const session = Astro.url.searchParams.get("session") ?? defaultWorkshopSession;
const baseUrl = import.meta.env.PUBLIC_SITE_URL ?? site.url;
const commitmentUrl = `${baseUrl}/commitment?session=${encodeURIComponent(session)}`;
const qrSrc = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&margin=20&color=1A2B4A&bgcolor=F8F9FB&data=${encodeURIComponent(commitmentUrl)}`;
---

<Layout title="Workshop QR Code" description="Scan to open the commitment card exercise.">
  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-lg text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">Facilitator</p>
      <h1 class="mt-2 font-display text-3xl font-bold">Scan to commit</h1>
      <p class="mt-3 text-slate">Display this on screen during Part Five — Action</p>

      <div class="mt-10 inline-block rounded-2xl border border-surface bg-white p-6 shadow-lg">
        <img
          src={qrSrc}
          alt="QR code linking to the commitment card page"
          width="400"
          height="400"
          class="mx-auto"
        />
      </div>

      <p class="mt-6 break-all text-sm text-slate">
        <a href={`/commitment?session=${session}`} class="font-medium text-coral hover:underline">
          {commitmentUrl}
        </a>
      </p>
      <p class="mt-2 text-xs text-slate">Session: {session}</p>
    </div>
  </section>
</Layout>
