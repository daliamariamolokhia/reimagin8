---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaButton from "../components/CtaButton.astro";
import PillarBadge from "../components/PillarBadge.astro";
import {
  bespokeBuildFormats,
  buildEntryPaths,
  buildPage,
  buildPortfolio,
  flagshipBuildFormats,
} from "../data/site";
---

<Layout
  title="Product Build"
  description="Web app development at the intersection of ideation and execution. MVPs, production builds, and sprint-to-ship from reimagin8."
>
  <Header slot="header" />

  <section class="hero-gradient px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <PillarBadge pillar="realise" class="mb-4" />
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">{buildPage.hero.eyebrow} · Product Build</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">{buildPage.hero.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75">{buildPage.hero.intro}</p>
    </div>
  </section>

  <!-- Entry paths -->
  <section class="border-b border-surface bg-surface/40 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-6 md:grid-cols-2">
        {
          buildEntryPaths.map((path) => (
            <article class="rounded-2xl border border-surface bg-white p-8 shadow-sm">
              <h2 class="font-display text-xl font-bold text-navy-900">{path.title}</h2>
              <p class="mt-3 leading-relaxed text-slate">{path.description}</p>
              <div class="mt-6">
                <CtaButton href={path.href} variant="outline">{path.cta}</CtaButton>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Flagship formats -->
  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-coral">{buildPage.signature.eyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold">{buildPage.signature.title}</h2>
        <p class="mt-4 text-lg text-slate">{buildPage.signature.intro}</p>
      </div>

      <div class="mt-12 space-y-12">
        {
          flagshipBuildFormats.map((format) => (
            <article
              id={format.slug}
              class="scroll-mt-24 overflow-hidden rounded-2xl border border-coral/30 bg-white shadow-sm ring-1 ring-coral/10"
            >
              <div class="grid lg:grid-cols-5">
                <div class="flex flex-col justify-between bg-navy-900 p-8 text-white lg:col-span-2">
                  <div>
                    <span class="inline-block rounded-full bg-coral/20 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-coral">
                      Flagship
                    </span>
                    <h3 class="mt-3 font-display text-2xl font-bold">{format.title}</h3>
                    <p class="mt-1 italic text-sky-light">"{format.subtitle}"</p>
                  </div>
                  <div class="mt-6 flex flex-wrap gap-2">
                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80">
                      {format.duration}
                    </span>
                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80">
                      {format.audience}
                    </span>
                    <span class="rounded-full bg-coral/20 px-3 py-1 text-xs font-medium text-coral">
                      {format.delivery}
                    </span>
                  </div>
                </div>
                <div class="p-8 lg:col-span-3">
                  <p class="leading-relaxed text-slate">{format.description}</p>
                  <h4 class="mt-6 text-sm font-semibold uppercase tracking-widest text-coral">Outcomes</h4>
                  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                    {
                      format.outcomes.map((outcome) => (
                        <li class="flex items-start gap-2 text-sm text-navy-800">
                          <svg class="mt-0.5 h-4 w-4 shrink-0 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          {outcome}
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mt-8">
                    <CtaButton href={`/contact?interest=${format.slug}`}>Enquire about this format</CtaButton>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Portfolio proof -->
  <section class="border-t border-surface bg-surface/40 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-coral">{buildPage.proof.eyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold">{buildPage.proof.title}</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:max-w-3xl">
        {
          buildPortfolio.map((item) => (
            <article class="rounded-2xl border border-surface bg-white p-6 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-widest text-coral">{item.category}</p>
              <h3 class="mt-2 font-display text-xl font-semibold text-navy-900">{item.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bespoke formats -->
  <section id="bespoke" class="scroll-mt-24 border-t border-surface px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-coral">{buildPage.bespoke.eyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold">{buildPage.bespoke.title}</h2>
        <p class="mt-4 text-lg text-slate">{buildPage.bespoke.intro}</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          bespokeBuildFormats.map((format) => (
            <article class="card-hover flex flex-col rounded-2xl border border-surface bg-white p-6 shadow-sm">
              <h3 class="font-display text-lg font-semibold text-navy-900">{format.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">{format.tagline}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-navy-800">
                  {format.duration}
                </span>
                <span class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-navy-800">
                  {format.audience}
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <CtaButton href="/contact?interest=product-build" variant="outline">Discuss a build engagement</CtaButton>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-surface bg-navy-900 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold text-white">{buildPage.cta.title}</h2>
      <p class="mt-4 text-lg text-white/70">{buildPage.cta.intro}</p>
      <div class="mt-8">
        <CtaButton href="/contact?interest=product-build" size="lg">Start a conversation</CtaButton>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
