---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaButton from "../components/CtaButton.astro";
import PillarBadge from "../components/PillarBadge.astro";
import { bespokeFormats, experiencesPage, flagshipExperiences } from "../data/site";
---

<Layout
  title="Experiences"
  description="Signature leadership experiences including The Growth Gap and The Reinvention Sprint — private, Harvard-grade sessions for teams ready to move."
>
  <Header slot="header" />

  <section class="hero-gradient px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-coral">{experiencesPage.hero.eyebrow}</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">{experiencesPage.hero.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/75">
        {experiencesPage.hero.intro}
      </p>
    </div>
  </section>

  <!-- Signature flagships -->
  <section class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-coral">{experiencesPage.signature.eyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold">{experiencesPage.signature.title}</h2>
        <p class="mt-4 text-lg text-slate">{experiencesPage.signature.intro}</p>
      </div>

      <div class="mt-12 space-y-12">
        {
          flagshipExperiences.map((experience) => (
            <article
              id={experience.slug}
              class="scroll-mt-24 overflow-hidden rounded-2xl border border-coral/30 bg-white shadow-sm ring-1 ring-coral/10"
            >
              <div class="grid lg:grid-cols-5">
                <div class="flex flex-col justify-between bg-navy-900 p-8 text-white lg:col-span-2">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="inline-block rounded-full bg-coral/20 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-coral">
                        Flagship
                      </span>
                      <PillarBadge
                        pillar={experience.pillar}
                        track={"reinventTrack" in experience ? experience.reinventTrack : undefined}
                      />
                    </div>
                    <h3 class="mt-3 font-display text-2xl font-bold">{experience.title}</h3>
                    <p class="mt-1 italic text-sky-light">"{experience.subtitle}"</p>
                  </div>
                  <div class="mt-6 flex flex-wrap gap-2">
                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80">
                      {experience.duration}
                    </span>
                    <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80">
                      {experience.audience}
                    </span>
                    <span class="rounded-full bg-coral/20 px-3 py-1 text-xs font-medium text-coral">
                      {experience.delivery}
                    </span>
                  </div>
                </div>
                <div class="p-8 lg:col-span-3">
                  <p class="leading-relaxed text-slate">{experience.description}</p>
                  <h4 class="mt-6 text-sm font-semibold uppercase tracking-widest text-coral">Outcomes</h4>
                  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                    {
                      experience.outcomes.map((outcome) => (
                        <li class="flex items-start gap-2 text-sm text-navy-800">
                          <svg class="mt-0.5 h-4 w-4 shrink-0 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          {outcome}
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mt-8">
                    <CtaButton href={`/contact?experience=${experience.slug}`}>Enquire about this experience</CtaButton>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bespoke formats -->
  <section id="bespoke" class="scroll-mt-24 border-t border-surface bg-surface/40 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-coral">{experiencesPage.bespoke.eyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold">{experiencesPage.bespoke.title}</h2>
        <p class="mt-4 text-lg text-slate">{experiencesPage.bespoke.intro}</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          bespokeFormats.map((format) => (
            <article class="card-hover flex flex-col rounded-2xl border border-surface bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-center gap-2">
                <PillarBadge
                  pillar={format.pillar}
                  track={"reinventTrack" in format ? format.reinventTrack : undefined}
                />
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy-900">{format.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">{format.tagline}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-navy-800">
                  {format.duration}
                </span>
                <span class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-navy-800">
                  {format.audience}
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <CtaButton href="/contact?experience=bespoke" variant="outline">Discuss a bespoke format</CtaButton>
      </div>
    </div>
  </section>

  <!-- Facilitator QR (Growth Gap only) -->
  <section class="border-t border-surface px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-3xl rounded-2xl border border-surface bg-white p-8 text-center">
      <h2 class="font-display text-xl font-bold">Running The Growth Gap?</h2>
      <p class="mt-2 text-sm text-slate">
        Display the QR code during Part Five — Action so participants can submit commitment cards.
      </p>
      <a href="/commitment/qr" class="mt-4 inline-block text-sm font-semibold text-coral hover:underline">
        Open facilitator QR page →
      </a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="border-t border-surface bg-navy-900 px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold text-white">{experiencesPage.cta.title}</h2>
      <p class="mt-4 text-lg text-white/70">{experiencesPage.cta.intro}</p>
      <div class="mt-8">
        <CtaButton href="/contact" size="lg">Start a conversation</CtaButton>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
